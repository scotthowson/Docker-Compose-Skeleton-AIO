#!/bin/bash
# =============================================================================
# dcs-grubcfg — writes /boot/grub/grub.cfg for the kernels in /boot: the newest first (the default), the older ones behind it.
# Debian and Ubuntu regenerate the file with update-grub when a kernel changes; Fedora has no such hook for the GRUB an image
# is built with, so a kernel-install plugin (95-dcs-grub.install) calls this. assemble.sh uses it for the first file of every
# image. The settings are the ones in /etc/default/grub.d/*.cfg. DCS_ROOT (a directory) exists for the tests and the build.
# =============================================================================
set -u
R="${DCS_ROOT:-}"
GRUB_CMDLINE_LINUX=""; GRUB_CMDLINE_LINUX_DEFAULT=""; GRUB_SERIAL_COMMAND="serial --unit=0 --speed=115200"
for f in "$R"/etc/default/grub.d/*.cfg; do [[ -f "$f" ]] && . "$f"; done
CMDLINE="root=LABEL=dcs-root ro $GRUB_CMDLINE_LINUX_DEFAULT $GRUB_CMDLINE_LINUX"
OUT="$R/boot/grub/grub.cfg"; mkdir -p "$R/boot/grub"

kernels=(); while IFS= read -r k; do kernels+=("${k##*/vmlinuz-}"); done < <(ls -1 "$R"/boot/vmlinuz-* 2>/dev/null | sort -V -r)
[[ ${#kernels[@]} -gt 0 ]] || { echo "dcs-grubcfg: no kernel in $R/boot" >&2; exit 1; }

{
    echo "set default=0"
    echo "set timeout=0"
    echo "if $GRUB_SERIAL_COMMAND; then"
    echo "    terminal_input serial console"
    echo "    terminal_output serial console"
    echo "fi"
    n=0
    for kv in "${kernels[@]}"; do
        initrd=""
        for c in "initrd.img-$kv" "initramfs-$kv.img"; do [[ -f "$R/boot/$c" ]] && { initrd=$c; break; }; done
        [[ -n "$initrd" ]] || continue
        title="DCS"; [[ $n -gt 0 ]] && title="DCS (kernel $kv)"
        printf "menuentry '%s' {\n    search --no-floppy --label --set=root dcs-root\n    linux /boot/vmlinuz-%s %s\n    initrd /boot/%s\n}\n" "$title" "$kv" "$CMDLINE" "$initrd"
        n=$((n + 1))
    done
} > "$OUT.tmp" && mv -f "$OUT.tmp" "$OUT"
[[ -z "${DCS_ROOT:-}" ]] && sync
echo "dcs-grubcfg: ${#kernels[@]} kernel(s) in ${OUT}"
