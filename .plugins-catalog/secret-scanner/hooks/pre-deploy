#!/bin/bash
# DCS plugin hook — contract v2 (see .plugins/README.md)
# stdin: JSON context {event, stack, project, compose_file, action, success,
#        containers[], template, compose, dry_run}
# env:   BASE_DIR COMPOSE_DIR DCS_EVENT PLUGIN_NAME PLUGIN_DIR PLUGIN_STATE_DIR
#        DCS_PLUGIN_CONFIG (JSON) DCS_DRY_RUN DCS_NTFY_URL NTFY_TOKEN
#        DOCKER_COMPOSE_CMD TZ + the names listed in the manifest's "env"
set -u
CTX=$(cat)
j() { printf '%s' "$CTX" | jq -r "$1" 2>/dev/null; }
cfg() { printf '%s' "${DCS_PLUGIN_CONFIG:-{\}}" | jq -r "$1 // empty" 2>/dev/null; }
STACK=$(j '.stack // empty'); SUCCESS=$(j 'if .success == null then "" else (.success|tostring) end')
DRY="${DCS_DRY_RUN:-$(j '.dry_run // false')}"
STATE="${PLUGIN_STATE_DIR:-${PLUGIN_DIR:-/tmp}/state}"; mkdir -p "$STATE" 2>/dev/null
containers() { printf '%s' "$CTX" | jq -r '.containers[]? // empty' 2>/dev/null; }
notify() {   # TITLE MESSAGE [priority]
    [[ -n "${DCS_NTFY_URL:-}" ]] || return 0
    curl -s -m 8 -H "Title: $1" -H "Priority: ${3:-default}" ${NTFY_TOKEN:+-H "Authorization: Bearer $NTFY_TOKEN"} \
        --data-binary "$2" "$DCS_NTFY_URL" >/dev/null 2>&1 || true
}
now_ts() { date -u '+%Y-%m-%dT%H:%M:%SZ'; }
COMPOSE=$(j '.compose // empty')
tmp=$(mktemp) || exit 0; trap 'rm -f "$tmp"' EXIT
printf '%s\n' "$COMPOSE" > "$tmp"
[[ -n "$STACK" && -f "$COMPOSE_DIR/$STACK/.env" ]] && cat "$COMPOSE_DIR/$STACK/.env" >> "$tmp"
hits=0
scan() {   # LABEL REGEX
    local m
    m=$(grep -nE -e "$2" "$tmp" 2>/dev/null | grep -v '\${' | head -3)
    [[ -n "$m" ]] && { echo "$1:"; sed 's/^\([0-9]*\):.*/  line \1/' <<< "$m"; hits=$((hits+1)); }
}
scan "AWS access key"        'AKIA[0-9A-Z]{16}'
scan "GitHub token"          'gh[pousr]_[A-Za-z0-9]{30,}'
scan "Slack token"           'xox[baprs]-[A-Za-z0-9-]{10,}'
scan "Stripe key"            '(sk|rk)_(live|test)_[A-Za-z0-9]{16,}'
scan "Google API key"        'AIza[0-9A-Za-z_-]{35}'
scan "JWT"                   'eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}'
scan "private key"           '-----BEGIN (RSA |EC |OPENSSH |DSA |PGP )?PRIVATE KEY'
scan "Telegram bot token"    '[0-9]{8,10}:AA[A-Za-z0-9_-]{33}'
scan "Discord webhook"       'discord(app)?\.com/api/webhooks/[0-9]+/[A-Za-z0-9_-]+'
scan "database URL with password" '(postgres|mysql|mongodb|redis|amqp)://[^:@/ ]+:[^@/ ]{4,}@'
scan "password assigned in clear" '^\s*-?\s*[A-Z_]*(PASSWORD|PASSWD|SECRET|TOKEN|API_KEY)[A-Z_]*\s*[:=]\s*"?[A-Za-z0-9!@#%^&*()_+.=-]{8,}"?\s*$'
if (( hits == 0 )); then echo "secret-scanner: nothing sensitive in clear text"; else echo "secret-scanner: $hits finding(s) — store these on the Secrets page and reference them as \${SECRETS_NAME}"; fi
