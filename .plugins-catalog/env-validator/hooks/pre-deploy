#!/bin/bash
# DCS plugin hook — contract v2 (see .plugins/README.md)
# stdin: JSON context {event, stack, project, compose_file, action, success,
#        containers[], template, compose, dry_run}
# env:   BASE_DIR COMPOSE_DIR DCS_EVENT PLUGIN_NAME PLUGIN_DIR PLUGIN_STATE_DIR
#        DCS_PLUGIN_CONFIG (JSON) DCS_DRY_RUN DCS_NTFY_URL NTFY_TOKEN
#        DOCKER_COMPOSE_CMD TZ + the names listed in the manifest's "env"
set -u
CTX=$(cat)
j() { printf '%s' "$CTX" | jq -r "$1" 2>/dev/null; }
cfg() { printf '%s' "${DCS_PLUGIN_CONFIG:-{\}}" | jq -r "$1 // empty" 2>/dev/null; }
STACK=$(j '.stack // empty'); SUCCESS=$(j 'if .success == null then "" else (.success|tostring) end')
DRY="${DCS_DRY_RUN:-$(j '.dry_run // false')}"
STATE="${PLUGIN_STATE_DIR:-${PLUGIN_DIR:-/tmp}/state}"; mkdir -p "$STATE" 2>/dev/null
containers() { printf '%s' "$CTX" | jq -r '.containers[]? // empty' 2>/dev/null; }
notify() {   # TITLE MESSAGE [priority]
    [[ -n "${DCS_NTFY_URL:-}" ]] || return 0
    curl -s -m 8 -H "Title: $1" -H "Priority: ${3:-default}" ${NTFY_TOKEN:+-H "Authorization: Bearer $NTFY_TOKEN"} \
        --data-binary "$2" "$DCS_NTFY_URL" >/dev/null 2>&1 || true
}
now_ts() { date -u '+%Y-%m-%dT%H:%M:%SZ'; }
COMPOSE=$(j '.compose // empty')
[[ -z "$COMPOSE" && -n "$STACK" && -f "$COMPOSE_DIR/$STACK/docker-compose.yml" ]] && COMPOSE=$(cat "$COMPOSE_DIR/$STACK/docker-compose.yml")
[[ -z "$COMPOSE" ]] && { echo "env-validator: no compose content in context"; exit 0; }
defined() {   # is VAR defined in the stack .env, the root .env, the secrets store or the standard set?
    local v="$1"
    case "$v" in PUID|PGID|TZ|APP_DATA_DIR|BASE_DIR|HOSTNAME|DOCKER_STACKS|SECRETS_*) return 0 ;; esac
    grep -qE "^${v}=" "$COMPOSE_DIR/$STACK/.env" "$BASE_DIR/.env" 2>/dev/null
}
issues=0
# ${VAR} / ${VAR:-default} / ${VAR:?msg} / $VAR
while IFS= read -r ref; do
    [[ -z "$ref" ]] && continue
    name="${ref#\$\{}"; name="${name#\$}"; name="${name%%[:}-?]*}"; name="${name%\}}"
    [[ "$ref" == *:-* || "$ref" == *:?* || "$ref" == *"}"* && "$ref" == *"-"* ]] && continue   # has a default
    defined "$name" || { echo "undefined: \${$name}"; issues=$((issues+1)); }
done < <(printf '%s' "$COMPOSE" | grep -oE '\$\{[A-Za-z_][A-Za-z0-9_]*(:?[-?][^}]*)?\}|\$[A-Za-z_][A-Za-z0-9_]*' | sort -u)
# stack .env hygiene
if [[ -n "$STACK" && -f "$COMPOSE_DIR/$STACK/.env" ]]; then
    dups=$(grep -oE '^[A-Za-z_][A-Za-z0-9_]*=' "$COMPOSE_DIR/$STACK/.env" | sort | uniq -d | tr -d '=')
    [[ -n "$dups" ]] && { echo "duplicate keys in .env: $(tr '\n' ' ' <<< "$dups")"; issues=$((issues+1)); }
    empties=$(grep -oE '^[A-Za-z_][A-Za-z0-9_]*=$' "$COMPOSE_DIR/$STACK/.env" | tr -d '=' | tr '\n' ' ')
    [[ -n "$empties" ]] && echo "empty values in .env: $empties"
fi
# secrets typed into the compose file
literal=$(printf '%s' "$COMPOSE" | grep -inE '(PASSWORD|PASSWD|SECRET|TOKEN|API_KEY)[A-Z_]*\s*[:=]\s*[^$ ]{6,}' | grep -v '\${' | head -5)
[[ -n "$literal" ]] && { echo "hard-coded credentials (use the Secrets page):"; printf '%s\n' "$literal" | sed 's/^/  line /'; issues=$((issues+1)); }
if (( issues == 0 )); then echo "env-validator: pass"; else echo "env-validator: $issues issue(s) — deployment continues, review before starting"; fi
exit 0
