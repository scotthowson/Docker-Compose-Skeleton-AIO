#!/bin/bash
# DCS plugin hook — contract v2 (see .plugins/README.md)
# stdin: JSON context {event, stack, project, compose_file, action, success,
#        containers[], template, compose, dry_run}
# env:   BASE_DIR COMPOSE_DIR DCS_EVENT PLUGIN_NAME PLUGIN_DIR PLUGIN_STATE_DIR
#        DCS_PLUGIN_CONFIG (JSON) DCS_DRY_RUN DCS_NTFY_URL NTFY_TOKEN
#        DOCKER_COMPOSE_CMD TZ + the names listed in the manifest's "env"
set -u
CTX=$(cat)
j() { printf '%s' "$CTX" | jq -r "$1" 2>/dev/null; }
cfg() { printf '%s' "${DCS_PLUGIN_CONFIG:-{\}}" | jq -r "$1 // empty" 2>/dev/null; }
STACK=$(j '.stack // empty'); SUCCESS=$(j 'if .success == null then "" else (.success|tostring) end')
DRY="${DCS_DRY_RUN:-$(j '.dry_run // false')}"
STATE="${PLUGIN_STATE_DIR:-${PLUGIN_DIR:-/tmp}/state}"; mkdir -p "$STATE" 2>/dev/null
containers() { printf '%s' "$CTX" | jq -r '.containers[]? // empty' 2>/dev/null; }
notify() {   # TITLE MESSAGE [priority]
    [[ -n "${DCS_NTFY_URL:-}" ]] || return 0
    curl -s -m 8 -H "Title: $1" -H "Priority: ${3:-default}" ${NTFY_TOKEN:+-H "Authorization: Bearer $NTFY_TOKEN"} \
        --data-binary "$2" "$DCS_NTFY_URL" >/dev/null 2>&1 || true
}
now_ts() { date -u '+%Y-%m-%dT%H:%M:%SZ'; }
[[ "$DRY" == "true" ]] && { echo "deploy-guard: dry run, no checkpoint"; exit 0; }
[[ -n "$STACK" ]] || exit 0
mkdir -p "$STATE/checkpoints"
f="$STATE/checkpoints/${STACK}-$(date +%Y%m%d-%H%M%S).json"
docker ps -a --filter "label=com.docker.compose.project=$STACK" --format '{{json .}}' 2>/dev/null | jq -s '.' > "$f" 2>/dev/null
echo "deploy-guard: checkpointed $(jq 'length' "$f" 2>/dev/null || echo 0) container(s) of $STACK to $(basename "$f")"
ls -1t "$STATE/checkpoints/${STACK}-"*.json 2>/dev/null | tail -n +11 | xargs -r rm -f
