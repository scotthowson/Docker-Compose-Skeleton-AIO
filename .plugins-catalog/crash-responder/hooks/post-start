#!/bin/bash
# DCS plugin hook — contract v2 (see .plugins/README.md)
# stdin: JSON context {event, stack, project, compose_file, action, success,
#        containers[], template, compose, dry_run}
# env:   BASE_DIR COMPOSE_DIR DCS_EVENT PLUGIN_NAME PLUGIN_DIR PLUGIN_STATE_DIR
#        DCS_PLUGIN_CONFIG (JSON) DCS_DRY_RUN DCS_NTFY_URL NTFY_TOKEN
#        DOCKER_COMPOSE_CMD TZ + the names listed in the manifest's "env"
set -u
CTX=$(cat)
j() { printf '%s' "$CTX" | jq -r "$1" 2>/dev/null; }
cfg() { printf '%s' "${DCS_PLUGIN_CONFIG:-{\}}" | jq -r "$1 // empty" 2>/dev/null; }
STACK=$(j '.stack // empty'); SUCCESS=$(j 'if .success == null then "" else (.success|tostring) end')
DRY="${DCS_DRY_RUN:-$(j '.dry_run // false')}"
STATE="${PLUGIN_STATE_DIR:-${PLUGIN_DIR:-/tmp}/state}"; mkdir -p "$STATE" 2>/dev/null
containers() { printf '%s' "$CTX" | jq -r '.containers[]? // empty' 2>/dev/null; }
notify() {   # TITLE MESSAGE [priority]
    [[ -n "${DCS_NTFY_URL:-}" ]] || return 0
    curl -s -m 8 -H "Title: $1" -H "Priority: ${3:-default}" ${NTFY_TOKEN:+-H "Authorization: Bearer $NTFY_TOKEN"} \
        --data-binary "$2" "$DCS_NTFY_URL" >/dev/null 2>&1 || true
}
now_ts() { date -u '+%Y-%m-%dT%H:%M:%SZ'; }
[[ -n "$STACK" ]] || exit 0
sleep 5
auto=$(cfg '.auto_restart'); cap=$(cfg '.max_restarts_per_hour'); [[ "$cap" =~ ^[0-9]+$ ]] || cap=3
lines=$(cfg '.log_lines'); [[ "$lines" =~ ^[0-9]+$ ]] || lines=50
mkdir -p "$STATE/crashes"; touch "$STATE/restarts.jsonl"; now=$(date +%s); crashed=0
while IFS=$'\t' read -r name status; do
    [[ -z "$name" ]] && continue
    [[ "$status" =~ ^Exited\ \(([0-9]+)\) ]] || continue
    code="${BASH_REMATCH[1]}"; [[ "$code" == "0" ]] && continue
    crashed=$((crashed+1))
    docker logs --tail "$lines" -t "$name" > "$STATE/crashes/${name}-$(date +%Y%m%d-%H%M%S).log" 2>&1
    recent=$(jq -c --arg n "$name" --argjson t "$((now - 3600))" 'select(.name == $n and .epoch >= $t)' "$STATE/restarts.jsonl" 2>/dev/null | wc -l)
    if [[ "$auto" != "false" ]] && (( recent < cap )); then
        docker restart "$name" >/dev/null 2>&1 && { echo "$name exited ($code): restarted ($((recent+1))/$cap this hour)"; jq -nc --arg n "$name" --argjson e "$now" '{name: $n, epoch: $e}' >> "$STATE/restarts.jsonl"; }
    else
        echo "$name exited ($code): NOT restarted (${recent}/${cap} restarts this hour)"
        notify "DCS: $name keeps crashing" "$name in $STACK exited with code $code; restart cap reached" high
    fi
done < <(docker ps -a --filter "label=com.docker.compose.project=$STACK" --format '{{.Names}}\t{{.Status}}' 2>/dev/null)
ls -1t "$STATE/crashes"/*.log 2>/dev/null | tail -n +51 | xargs -r rm -f
tail -n 500 "$STATE/restarts.jsonl" > "$STATE/r.tmp" 2>/dev/null && mv -f "$STATE/r.tmp" "$STATE/restarts.jsonl"
(( crashed == 0 )) && echo "crash-responder: no crashed containers in $STACK"
